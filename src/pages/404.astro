---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dict, homeUrl } from '../i18n';

const t = dict.ka;
const en = dict.en;
---

<Base lang="ka" title={`${t.notFound.title} — BAU BILD`} index={false}>
  <Header lang="ka" />
  <main class="section">
    <div class="container nf">
      <span class="latin nf__code">404</span>
      <h1 class="h2">{t.notFound.title}</h1>
      <p>{t.notFound.text}</p>
      <a class="arrow-link" href={homeUrl('ka')}>{t.notFound.back}</a>
      <a class="arrow-link" href={homeUrl('en')} lang="en">{en.notFound.back}</a>
    </div>
  </main>
  <Footer lang="ka" />
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-height: 50vh;
  }
  .nf__code {
    font-weight: 900;
    font-size: 72px;
    line-height: 1;
    color: var(--orange);
  }
  .nf p {
    color: var(--muted);
  }
</style>
