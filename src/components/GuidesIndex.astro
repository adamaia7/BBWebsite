---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { homeUrl, LANGS, type Lang } from '../i18n';
import { guides, guideUi, guideUrl } from '../i18n/guides';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = guideUi[lang];
const paths = Object.fromEntries(LANGS.map((l) => [l, guideUrl(l)])) as Record<Lang, string>;
---

<Base lang={lang} title={ui.metaTitle} description={ui.metaDescription} paths={paths}>
  <Header lang={lang} paths={paths} />
  <main id="main" tabindex="-1" class="section">
    <div class="container gi">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href={homeUrl(lang)}>{ui.home}</a>
      </nav>
      <h1 class="h2">{ui.title}</h1>
      <p class="gi__lead">{ui.lead}</p>
      <ul class="gi__list">
        {guides[lang].map((g) => (
          <li class="gi__item">
            <h2 class="gi__title"><a href={guideUrl(lang, g.slug)}>{g.h1}</a></h2>
            <p>{g.metaDescription}</p>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .gi {
    max-width: 860px;
  }
  .crumbs {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .crumbs a {
    color: inherit;
  }
  .gi__lead {
    margin-top: 14px;
    font-size: 18px;
    color: var(--muted);
  }
  .gi__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .gi__item {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .gi__title {
    font-size: 22px;
    line-height: 1.3;
    margin-bottom: 8px;
  }
  .gi__title a {
    text-decoration: none;
  }
  .gi__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }
  .gi__item p {
    color: var(--muted);
  }
</style>
