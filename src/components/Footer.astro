---
import Logo from './logo/Logo.astro';
import { CONTACT } from '../config';
import { dict, homeUrl, type Lang } from '../i18n';
import { guideUrl } from '../i18n/guides';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const home = homeUrl(lang);
const social = [
  { label: 'Facebook', href: CONTACT.facebook },
  { label: 'Instagram', href: CONTACT.instagram },
].filter((s) => s.href);
---

<footer class="footer on-dark">
  <div class="container footer__inner">
    <div class="footer__grid">
      <a class="footer__logo" href={home} aria-label="BAU BILD">
        <Logo height={96} tagline text={{ line: t.tagline, a: t.taglineA, b: t.taglineB }} />
      </a>
      <nav class="footer__col" aria-label={t.nav.footerLabel}>
        <span class="footer__head">{t.nav.menu}</span>
        <a href={`${home}#services`}>{t.nav.services}</a>
        <a href={`${home}#projects`}>{t.nav.projects}</a>
        <a href={`${home}#about`}>{t.nav.about}</a>
        <a href={`${home}#contact`}>{t.nav.contact}</a>
        <a href={guideUrl(lang)}>{t.nav.guides}</a>
      </nav>
      <div class="footer__col">
        <span class="footer__head">{t.nav.contact}</span>
        <a class="latin" href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
        <a class="latin" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span>{t.contact.areaValue}</span>
      </div>
      {social.length > 0 && (
        <div class="footer__col">
          <span class="footer__head">{t.footer.social}</span>
          {social.map((s) => <a href={s.href} rel="noopener">{s.label}</a>)}
        </div>
      )}
    </div>
    <div class="footer__bottom">
      <span>{t.footer.rights}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer);
    color: var(--light);
    padding: 56px 0 32px;
  }
  @media (min-width: 900px) {
    .footer {
      padding: 80px 0 40px;
    }
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }
  }
  .footer__logo {
    text-decoration: none;
    align-self: start;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .footer__col a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }
  .footer__head {
    margin-bottom: 4px;
    font-size: 14px;
    font-weight: 700;
    color: #b8b3aa;
  }
  .footer__bottom {
    border-top: 1px solid #3e434a;
    padding-top: 24px;
    font-size: 14px;
    color: #b8b3aa;
  }
</style>
