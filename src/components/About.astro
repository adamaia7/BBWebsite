---
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
---

<section class="section section--alt" id="about">
  <div class="container about">
    <div class="placeholder about__photo">{t.about.photo}</div>
    <div class="about__text">
      <span class="eyebrow">{t.nav.about}</span>
      <h2 class="h2">{t.about.title}</h2>
      <p class="about__p">{t.about.text}</p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px;
    }
  }
  .about__photo {
    height: 260px;
  }
  @media (min-width: 900px) {
    .about__photo {
      height: 480px;
    }
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .about__p {
    margin-top: 10px;
    color: var(--muted);
    max-width: 560px;
  }
</style>
