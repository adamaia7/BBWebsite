---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { dict, homeUrl, LANGS, type Lang } from '../i18n';
import { guides, guideUi, guideUrl } from '../i18n/guides';
import { servicePages, serviceUrl } from '../i18n/services';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const ui = guideUi[lang];
const guide = guides[lang].find((g) => g.slug === slug)!;
const service = servicePages[lang].find((s) => s.slug === guide.service)!;
const paths = Object.fromEntries(LANGS.map((l) => [l, guideUrl(l, slug)])) as Record<Lang, string>;
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);

const extraLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.h1,
    description: guide.metaDescription,
    inLanguage: lang,
    datePublished: guide.published,
    mainEntityOfPage: abs(paths[lang]),
    image: abs('og.jpg'),
    author: { '@id': abs(homeUrl('ka')) + '#company' },
    publisher: { '@id': abs(homeUrl('ka')) + '#company' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: abs(homeUrl(lang)) },
      { '@type': 'ListItem', position: 2, name: ui.eyebrow, item: abs(guideUrl(lang)) },
      { '@type': 'ListItem', position: 3, name: guide.h1, item: abs(paths[lang]) },
    ],
  },
];
---

<Base lang={lang} title={guide.metaTitle} description={guide.metaDescription} paths={paths} extraLd={extraLd}>
  <Header lang={lang} paths={paths} />
  <main id="main" tabindex="-1">
    <section class="g-hero on-dark">
      <div class="container g-narrow">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={homeUrl(lang)}>{ui.home}</a>
          <span aria-hidden="true">/</span>
          <a href={guideUrl(lang)}>{ui.eyebrow}</a>
        </nav>
        <h1 class="g-hero__title">{guide.h1}</h1>
        <p class="g-hero__lead">{guide.lead}</p>
      </div>
    </section>

    <article class="section">
      <div class="container g-narrow g-body">
        {guide.sections.map((s) => (
          <section>
            <h2>{s.h2}</h2>
            {s.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))}
      </div>
    </article>

    <section class="section section--border">
      <div class="container g-narrow">
        <h2 class="h2">{ui.faq}</h2>
        <div class="faq">
          {guide.faq.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="g-service">
          <span>{ui.service}:</span>
          <a class="arrow-link" href={serviceUrl(lang, service.slug)}>
            {service.h1}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E07B24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </p>
      </div>
    </section>

    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .g-hero {
    background: var(--band);
    color: var(--light);
    padding: 48px 0 56px;
  }
  @media (min-width: 900px) {
    .g-hero {
      padding: 72px 0 88px;
    }
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--light-muted);
    margin-bottom: 28px;
  }
  .crumbs a {
    color: inherit;
  }
  .g-hero__title {
    font-size: 30px;
    line-height: 1.2;
  }
  @media (min-width: 900px) {
    .g-hero__title {
      font-size: 44px;
    }
  }
  .g-hero__lead {
    margin-top: 18px;
    font-size: 18px;
    color: var(--light-muted);
  }
  .g-narrow {
    max-width: 860px;
  }
  .g-body {
    display: flex;
    flex-direction: column;
    gap: 36px;
    font-size: 17px;
    line-height: 1.7;
  }
  .g-body h2 {
    font-size: 23px;
    margin-bottom: 12px;
  }
  .g-body p + p {
    margin-top: 14px;
  }
  .faq {
    margin-top: 24px;
    border-top: 1px solid var(--border);
  }
  .faq__item {
    border-bottom: 1px solid var(--border);
  }
  .faq__item summary {
    cursor: pointer;
    padding: 18px 0;
    font-weight: 700;
    min-height: 44px;
  }
  .faq__item p {
    padding-bottom: 18px;
    color: var(--muted);
  }
  .g-service {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 40px;
    color: var(--muted);
  }
</style>
