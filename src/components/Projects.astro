---
import { dict, url, type Lang } from '../i18n';
import ServiceIcon from './ServiceIcon.astro';
import { SERVICE_SLUGS } from '../i18n/services';
import { PROJECT_CASES, projectUrl } from '../i18n/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
// რეალური პროექტები (src/i18n/projects.ts) ცვლის სატესტო ბარათებს, როგორც კი პირველი დაემატება
type Card = { service: number; name: string; meta: string; image: string; href?: string };
const cards: Card[] = PROJECT_CASES.length
  ? PROJECT_CASES.slice(0, 6).map((p) => ({
      service: Math.max(0, SERVICE_SLUGS.indexOf(p.service as (typeof SERVICE_SLUGS)[number])),
      name: p[lang].name,
      meta: [p[lang].location, p.area ? `${p.area} ${lang === 'ka' ? 'მ²' : 'm²'}` : '', String(p.year)].filter(Boolean).join(' · '),
      image: p.images[0] ?? '',
      href: projectUrl(lang, p.slug),
    }))
  : t.projects.items;
---

<section class="section section--alt" id="projects">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">{t.nav.projects}</span>
        <h2 class="h2">{t.projects.title}</h2>
      </div>
    </div>
    <ul class="projects">
      {cards.map((p) => (
        <li class="project">
          {p.image ? (
            <img class="project__img" src={url(p.image)} alt={p.name} loading="lazy" width="1200" height="432" />
          ) : (
            <div class="project__img project__blank" aria-hidden="true">
              <ServiceIcon index={p.service} size={64} />
            </div>
          )}
          <div class="project__body">
            <span class="project__type">{t.services.items[p.service].title}</span>
            <h3 class="project__name">{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h3>
            <span class="project__meta">{p.meta}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 24px;
  }
  @media (min-width: 900px) {
    .projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .project__img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (min-width: 900px) {
    .project__img {
      height: 320px;
    }
  }
  /* ფოტოს გარეშე პროექტი: ნახაზის ბადე + სერვისის იკონა */
  .project__blank {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-text);
    background-color: var(--card);
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center;
    border: 1px solid var(--border);
  }
  .project__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .project__type {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }
  .project__name {
    font-size: 20px;
  }
  .project__name a {
    color: inherit;
  }
  .project__meta {
    color: var(--muted);
    font-size: 15px;
  }
</style>
