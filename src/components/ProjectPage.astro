---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { dict, homeUrl, url, LANGS, type Lang } from '../i18n';
import { servicePages, serviceUrl } from '../i18n/services';
import { PROJECT_CASES, projectUi, projectUrl } from '../i18n/projects';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = dict[lang];
const ui = projectUi[lang];
const project = PROJECT_CASES.find((p) => p.slug === slug)!;
const text = project[lang];
const service = servicePages[lang].find((s) => s.slug === project.service)!;
// შიდა ბმულები: ჯერ იმავე სერვისის პროექტები, შემდეგ დანარჩენი (მაქს. 3)
const others = PROJECT_CASES.filter((p) => p.slug !== slug);
const more = [...others.filter((p) => p.service === project.service), ...others.filter((p) => p.service !== project.service)].slice(0, 3);
const paths = Object.fromEntries(LANGS.map((l) => [l, projectUrl(l, slug)])) as Record<Lang, string>;
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);
const images = project.images.map((src, i) => ({ src: url(src), alt: text.imageAlts[i] ?? text.name }));

const facts = [
  { k: ui.location, v: text.location },
  { k: ui.year, v: String(project.year) },
  ...(project.area ? [{ k: ui.area, v: `${project.area.toLocaleString('en-US').replace(/,/g, ' ')} ${lang === 'ka' ? 'მ²' : 'm²'}` }] : []),
  ...(project.months ? [{ k: ui.duration, v: ui.months(project.months) }] : []),
];

const extraLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: text.h1,
    headline: text.h1,
    description: text.metaDescription,
    inLanguage: lang,
    url: abs(paths[lang]),
    dateCreated: String(project.year),
    image: images.map((im) => abs(im.src)),
    creator: { '@id': abs(homeUrl('ka')) + '#company' },
    locationCreated: { '@type': 'Place', name: text.location },
    about: { '@type': 'Service', name: service.h1, url: abs(serviceUrl(lang, service.slug)) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: abs(homeUrl(lang)) },
      { '@type': 'ListItem', position: 2, name: t.nav.projects, item: abs(homeUrl(lang)) + '#projects' },
      { '@type': 'ListItem', position: 3, name: text.name, item: abs(paths[lang]) },
    ],
  },
];
---

<Base lang={lang} title={text.metaTitle} description={text.metaDescription} paths={paths} extraLd={extraLd} preloadImage={images[0]?.src}>
  <Header lang={lang} paths={paths} />
  <main id="main" tabindex="-1">
    <section class="pp-hero on-dark">
      <div class="container">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={homeUrl(lang)}>{ui.home}</a>
          <span aria-hidden="true">/</span>
          <a href={`${homeUrl(lang)}#projects`}>{t.nav.projects}</a>
        </nav>
        <span class="eyebrow pp-hero__eyebrow">{ui.eyebrow}</span>
        <h1 class="pp-hero__title">{text.h1}</h1>
        <p class="pp-hero__lead">{text.lead}</p>
      </div>
    </section>

    {images[0] && (
      <div class="container pp-cover">
        <img src={images[0].src} alt={images[0].alt} width="1600" height="900" fetchpriority="high" />
      </div>
    )}

    <section class="section">
      <div class="container pp-grid">
        <div class="pp-text">
          <h2 class="h2">{ui.challenge}</h2>
          {text.challenge.map((p) => <p>{p}</p>)}
          <h2 class="h2">{ui.solution}</h2>
          {text.solution.map((p) => <p>{p}</p>)}
        </div>
        <aside class="pp-card">
          <h2 class="pp-card__title">{ui.facts}</h2>
          <dl class="pp-facts">
            {facts.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))}
            <div>
              <dt>{ui.service}</dt>
              <dd><a href={serviceUrl(lang, service.slug)}>{t.services.items[servicePages[lang].indexOf(service)].title}</a></dd>
            </div>
          </dl>
          <h3 class="pp-card__sub">{ui.scope}</h3>
          <ul class="pp-list">
            {text.scope.map((i) => <li>{i}</li>)}
          </ul>
          <a class="btn pp-btn" href="#contact">{ui.cta}</a>
        </aside>
      </div>
    </section>

    {images.length > 1 && (
      <section class="section section--border">
        <div class="container">
          <h2 class="h2 pp-gallery__title">{ui.gallery}</h2>
          <ul class="pp-gallery">
            {images.slice(1).map((im) => (
              <li><img src={im.src} alt={im.alt} width="1200" height="800" loading="lazy" /></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section section--border">
      <div class="container">
        <p class="pp-related">
          <a class="arrow-link" href={serviceUrl(lang, service.slug)}>
            {service.h1}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E07B24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </p>
        {more.length > 0 && (
          <>
            <h2 class="h2 pp-gallery__title">{ui.others}</h2>
            <ul class="pp-others">
              {more.map((o) => (
                <li>
                  <a class="arrow-link" href={projectUrl(lang, o.slug)}>
                    {o[lang].name}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E07B24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>

    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .pp-hero {
    background: var(--band);
    color: var(--light);
    padding: 48px 0 56px;
  }
  @media (min-width: 900px) {
    .pp-hero {
      padding: 72px 0 88px;
    }
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--light-muted);
    margin-bottom: 28px;
  }
  .crumbs a {
    color: inherit;
  }
  .pp-hero__eyebrow {
    color: #e59a55;
  }
  .pp-hero__title {
    font-size: 32px;
    line-height: 1.2;
    max-width: 20ch;
  }
  @media (min-width: 900px) {
    .pp-hero__title {
      font-size: 52px;
    }
  }
  .pp-hero__lead {
    margin-top: 18px;
    max-width: 60ch;
    font-size: 18px;
    color: var(--light-muted);
  }
  .pp-cover {
    margin-top: 40px;
  }
  .pp-cover img,
  .pp-gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .pp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .pp-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 72px;
    }
  }
  .pp-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 17px;
    line-height: 1.7;
  }
  .pp-text .h2:not(:first-child) {
    margin-top: 16px;
  }
  .pp-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .pp-card__title {
    font-size: 21px;
    margin-bottom: 16px;
  }
  .pp-card__sub {
    font-size: 17px;
    margin: 24px 0 12px;
  }
  .pp-facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pp-facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
  }
  .pp-facts dt {
    color: var(--muted);
  }
  .pp-facts dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .pp-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pp-list li {
    position: relative;
    padding-left: 22px;
  }
  .pp-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 6px;
    background: var(--orange);
    border-radius: 1px;
  }
  .pp-btn {
    margin-top: 24px;
  }
  .pp-gallery__title {
    margin-bottom: 20px;
  }
  .pp-gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 700px) {
    .pp-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pp-related {
    margin-bottom: 32px;
  }
  .pp-others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
