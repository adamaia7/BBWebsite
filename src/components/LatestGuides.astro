---
// მთავარ გვერდზე უახლესი სტატიები: ახალ გვერდებს მთავარიდან პირდაპირ ბმული აქვთ, რაც ინდექსაციას აჩქარებს.
import { type Lang } from '../i18n';
import { guidesByDate, guideUi, guideUrl } from '../i18n/guides';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = guideUi[lang];
const latest = guidesByDate(lang).slice(0, 3);
---

<section class="section section--border">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">{ui.eyebrow}</span>
        <h2 class="h2">{ui.latest}</h2>
      </div>
      <a class="arrow-link" href={guideUrl(lang)}>
        {ui.all}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E07B24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <ul class="lg">
      {latest.map((g) => (
        <li class="lg__item">
          <h3 class="lg__title"><a href={guideUrl(lang, g.slug)}>{g.h1}</a></h3>
          <p>{g.metaDescription}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .lg {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .lg__item {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
  }
  .lg__title {
    font-size: 20px;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .lg__title a {
    text-decoration: none;
  }
  .lg__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }
  .lg__item p {
    color: var(--muted);
    font-size: 15px;
  }
</style>
