---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { dict, homeUrl, LANGS, type Lang } from '../i18n';
import { servicePages, serviceUi, serviceUrl } from '../i18n/services';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = dict[lang];
const ui = serviceUi[lang];
const pages = servicePages[lang];
const page = pages.find((p) => p.slug === slug)!;
const others = pages.filter((p) => p.slug !== slug);
const paths = Object.fromEntries(LANGS.map((l) => [l, serviceUrl(l, slug)])) as Record<Lang, string>;
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);

const extraLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.h1,
    description: page.metaDescription,
    serviceType: page.h1,
    url: abs(paths[lang]),
    provider: { '@id': abs(homeUrl('ka')) + '#company' },
    areaServed: { '@type': 'Country', name: lang === 'ka' ? 'საქართველო' : 'Georgia' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: abs(homeUrl(lang)) },
      { '@type': 'ListItem', position: 2, name: t.nav.services, item: abs(homeUrl(lang)) + '#services' },
      { '@type': 'ListItem', position: 3, name: page.h1, item: abs(paths[lang]) },
    ],
  },
];
---

<Base lang={lang} title={page.metaTitle} description={page.metaDescription} paths={paths} extraLd={extraLd}>
  <Header lang={lang} paths={paths} />
  <main id="main" tabindex="-1">
    <section class="sp-hero on-dark">
      <div class="container">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={homeUrl(lang)}>{ui.home}</a>
          <span aria-hidden="true">/</span>
          <a href={`${homeUrl(lang)}#services`}>{t.nav.services}</a>
        </nav>
        <span class="eyebrow sp-hero__eyebrow">{ui.eyebrow}</span>
        <h1 class="sp-hero__title">{page.h1}</h1>
        <p class="sp-hero__lead">{page.lead}</p>
        <a class="btn sp-btn" href="#contact">{ui.call}</a>
      </div>
    </section>

    <section class="section">
      <div class="container sp-grid">
        <div class="sp-text">
          {page.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="sp-card">
          <h2 class="sp-card__title">{page.includesTitle}</h2>
          <ul class="sp-list">
            {page.includes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--border">
      <div class="container sp-narrow">
        <h2 class="h2">{ui.faq}</h2>
        <div class="faq">
          {page.faq.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--border">
      <div class="container">
        <h2 class="h2 sp-others__title">{ui.others}</h2>
        <ul class="sp-others">
          {others.map((o) => (
            <li>
              <a class="arrow-link" href={serviceUrl(lang, o.slug)}>
                {o.h1}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E07B24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .sp-hero {
    background: var(--band);
    color: var(--light);
    padding: 48px 0 56px;
  }
  @media (min-width: 900px) {
    .sp-hero {
      padding: 72px 0 88px;
    }
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--light-muted);
    margin-bottom: 28px;
  }
  .crumbs a {
    color: inherit;
  }
  .sp-hero__eyebrow {
    color: #e59a55;
  }
  .sp-hero__title {
    font-size: 32px;
    line-height: 1.2;
    max-width: 18ch;
  }
  @media (min-width: 900px) {
    .sp-hero__title {
      font-size: 52px;
    }
  }
  .sp-hero__lead {
    margin-top: 18px;
    max-width: 60ch;
    font-size: 18px;
    color: var(--light-muted);
  }
  .sp-btn {
    margin-top: 28px;
  }
  .sp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .sp-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 72px;
    }
  }
  .sp-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 17px;
    line-height: 1.7;
  }
  .sp-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .sp-card__title {
    font-size: 21px;
    margin-bottom: 16px;
  }
  .sp-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sp-list li {
    position: relative;
    padding-left: 22px;
  }
  .sp-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 6px;
    background: var(--orange);
    border-radius: 1px;
  }
  .sp-narrow {
    max-width: 860px;
  }
  .faq {
    margin-top: 24px;
    border-top: 1px solid var(--border);
  }
  .faq__item {
    border-bottom: 1px solid var(--border);
  }
  .faq__item summary {
    cursor: pointer;
    padding: 18px 0;
    font-weight: 700;
    min-height: 44px;
  }
  .faq__item p {
    padding-bottom: 18px;
    color: var(--muted);
  }
  .sp-others__title {
    margin-bottom: 20px;
  }
  .sp-others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 32px;
  }
  @media (min-width: 900px) {
    .sp-others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
