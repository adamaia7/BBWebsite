---
import { CONTACT, WEB3FORMS_KEY } from '../config';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const f = t.contact.form;
const waNumber = CONTACT.whatsapp.replace(/\D/g, '');
---

<section class="section section--alt" id="contact">
  <div class="container contact">
    <div class="contact__info">
      <div>
        <span class="eyebrow">{t.nav.contact}</span>
        <h2 class="h2">{t.contact.title}</h2>
        <p class="contact__lead">{t.contact.text}</p>
      </div>

      <dl class="contact__list">
        <div>
          <dt>{t.contact.phone}</dt>
          <dd><a class="latin contact__big" href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>{t.contact.email}</dt>
          <dd><a class="latin contact__big" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
        </div>
        <div>
          <dt>{t.contact.area}</dt>
          <dd class="contact__addr">{t.contact.areaValue}</dd>
        </div>
        <div>
          <dt>{t.contact.hours}</dt>
          <dd class="contact__addr">{t.contact.hoursValue}</dd>
        </div>
        <div>
          <dt>{t.contact.messengers}</dt>
          <dd class="contact__msg">
            <a href={CONTACT.whatsapp} rel="noopener">WhatsApp</a>
            <a href={CONTACT.viber}>Viber</a>
          </dd>
        </div>
      </dl>
    </div>

    <form
      class="form"
      data-contact-form
      data-key={WEB3FORMS_KEY}
      data-email={CONTACT.email}
      data-wa={waNumber}
      data-wa-intro={f.waIntro}
      novalidate
    >
      <input type="hidden" name="subject" value={f.subject} />
      <input type="hidden" name="from_name" value="BAU BILD website" />
      <div class="visually-hidden" aria-hidden="true">
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="f-name">{f.name}<span class="req" aria-hidden="true"> *</span></label>
        <input id="f-name" name="name" type="text" autocomplete="name" required aria-required="true" data-label={f.name} />
      </div>
      <div class="field">
        <label for="f-phone">{t.contact.phone}<span class="req" aria-hidden="true"> *</span></label>
        <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-required="true" data-label={t.contact.phone} />
      </div>
      <div class="field field--full">
        <label for="f-type">{f.type}</label>
        <select id="f-type" name="work_type" data-label={f.type}>
          <option value="">{f.choose}</option>
          {t.services.items.map((s) => <option>{s.title}</option>)}
          <option>{f.other}</option>
        </select>
      </div>
      <div class="field">
        <label for="f-location">{f.location}</label>
        <input id="f-location" name="location" type="text" autocomplete="address-level2" placeholder={f.locationHint} data-label={f.location} />
      </div>
      <div class="field">
        <label for="f-size">{f.size}</label>
        <input id="f-size" name="area_m2" type="text" inputmode="numeric" data-label={f.size} />
      </div>
      <div class="field field--full">
        <label for="f-msg">{f.message}</label>
        <textarea id="f-msg" name="message" rows="4" placeholder={f.messageHint} data-label={f.message}></textarea>
      </div>
      <p class="form__note field--full"><span class="req" aria-hidden="true">*</span> {f.required}</p>
      <button class="form__submit field--full" type="submit" data-label={f.send} data-sending={f.sending}>{f.send}</button>
      <button class="form__wa field--full" type="button" data-wa-send>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4z"></path></svg>
        {f.orWhatsapp}
      </button>
      <p
        class="form__status field--full"
        role="status"
        aria-live="polite"
        data-success={f.success}
        data-error={f.error}
      >
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.form__status');
  const button = form?.querySelector<HTMLButtonElement>('.form__submit');
  const waButton = form?.querySelector<HTMLButtonElement>('[data-wa-send]');

  /** შევსებული ველები ტექსტად: „სახელი: ...“ */
  function summary(f: HTMLFormElement): string[] {
    return [...f.querySelectorAll<HTMLInputElement>('[data-label]')]
      .filter((el) => el.value.trim())
      .map((el) => `${el.dataset.label}: ${el.value.trim()}`);
  }

  // WhatsApp-ით გაგზავნა: იხსნება ჩატი მზა ტექსტით. ველები სავალდებულო არ არის.
  waButton?.addEventListener('click', () => {
    if (!form) return;
    const text = [form.dataset.waIntro ?? '', ...summary(form)].join('\n');
    window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  async function send(f: HTMLFormElement): Promise<boolean> {
    const data = new FormData(f);
    if (data.get('botcheck')) return true;
    const key = f.dataset.key;
    if (key) {
      data.append('access_key', key);
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      return res.ok && json.success === true;
    }
    // FormSubmit: გასაღები არ სჭირდება, მოთხოვნა პირდაპირ მეილზე მიდის.
    const body: Record<string, string> = {
      _subject: String(data.get('subject') ?? ''),
      _template: 'table',
      _captcha: 'false',
      _honey: '',
    };
    for (const line of summary(f)) {
      const i = line.indexOf(': ');
      body[line.slice(0, i)] = line.slice(i + 2);
    }
    body['Page'] = location.href;
    const res = await fetch(`https://formsubmit.co/ajax/${f.dataset.email}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    });
    const json = await res.json();
    return res.ok && String(json.success) === 'true';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status || !button) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    button.disabled = true;
    button.textContent = button.dataset.sending ?? '';
    status.textContent = '';

    let ok = false;
    try {
      ok = await send(form);
    } catch {
      ok = false;
    }
    if (ok) {
      form.reset();
      status.textContent = status.dataset.success ?? '';
      status.dataset.state = 'success';
    } else {
      // ველები არ იშლება, რომ ვიზიტორმა იგივე WhatsApp-ით გაგზავნოს
      status.textContent = status.dataset.error ?? '';
      status.dataset.state = 'error';
    }
    button.disabled = false;
    button.textContent = button.dataset.label ?? '';
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 72px;
    }
  }
  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .contact__lead {
    margin-top: 12px;
    color: var(--muted);
  }
  .contact__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact__list dt {
    font-size: 14px;
    color: var(--muted);
  }
  .contact__list dd {
    margin: 0;
  }
  .contact__big {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }
  .contact__addr {
    font-weight: 700;
    font-size: 18px;
  }
  .contact__msg {
    display: flex;
    gap: 20px;
    font-weight: 700;
  }
  .contact__msg a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .form {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 36px;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 14px;
    font-weight: 600;
  }
  .form__note {
    font-size: 14px;
    color: var(--muted);
  }
  .req {
    color: var(--accent-text);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    border: 1px solid var(--input-border);
    background: var(--input);
    color: var(--text);
    border-radius: 3px;
    padding: 0 16px;
    font: inherit;
  }
  .field textarea {
    padding: 14px 16px;
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--orange);
    outline-offset: 0;
    border-color: transparent;
  }
  .form__submit {
    min-height: 56px;
    background: var(--orange);
    color: var(--on-orange);
    border: 0;
    border-radius: 3px;
    font: inherit;
    font-weight: 700;
    font-size: 17px;
    cursor: pointer;
  }
  .form__submit:hover {
    background: #ea8a36;
  }
  .form__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .form__wa {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 3px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .form__wa:hover {
    border-color: var(--orange);
  }
  .form__status:empty {
    display: none;
  }
  .form__status[data-state='success'] {
    color: var(--text);
    font-weight: 600;
  }
  .form__status[data-state='error'] {
    color: var(--accent-text);
    font-weight: 600;
  }
</style>
