---
import { CONTACT, WEB3FORMS_KEY } from '../config';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const f = t.contact.form;
---

<section class="section section--alt" id="contact">
  <div class="container contact">
    <div class="contact__info">
      <div>
        <span class="eyebrow">{t.nav.contact}</span>
        <h2 class="h2">{t.contact.title}</h2>
        <p class="contact__lead">{t.contact.text}</p>
      </div>

      <dl class="contact__list">
        <div>
          <dt>{t.contact.phone}</dt>
          <dd><a class="latin contact__big" href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>{t.contact.email}</dt>
          <dd><a class="latin contact__big" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
        </div>
        <div>
          <dt>{t.contact.area}</dt>
          <dd class="contact__addr">{t.contact.areaValue}</dd>
        </div>
        <div>
          <dt>{t.contact.hours}</dt>
          <dd class="contact__addr">{t.contact.hoursValue}</dd>
        </div>
        <div>
          <dt>{t.contact.messengers}</dt>
          <dd class="contact__msg">
            <a href={CONTACT.whatsapp} rel="noopener">WhatsApp</a>
            <a href={CONTACT.viber}>Viber</a>
          </dd>
        </div>
      </dl>
    </div>

    <form class="form" data-contact-form data-key={WEB3FORMS_KEY} novalidate>
      <input type="hidden" name="subject" value={f.subject} />
      <input type="hidden" name="from_name" value="BAU BILD website" />
      <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

      <div class="field">
        <label for="f-name">{f.name}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-phone">{t.contact.phone}</label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
      <div class="field field--full">
        <label for="f-type">{f.type}</label>
        <select id="f-type" name="work_type">
          <option value="">{f.choose}</option>
          {t.services.items.map((s) => <option>{s.title}</option>)}
          <option>{f.other}</option>
        </select>
      </div>
      <div class="field field--full">
        <label for="f-msg">{f.message}</label>
        <textarea id="f-msg" name="message" rows="5"></textarea>
      </div>
      <button class="form__submit field--full" type="submit" data-label={f.send} data-sending={f.sending}>{f.send}</button>
      <p
        class="form__status field--full"
        role="status"
        aria-live="polite"
        data-success={f.success}
        data-error={f.error}
        data-not-configured={f.notConfigured}
      >
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.form__status');
  const button = form?.querySelector<HTMLButtonElement>('.form__submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status || !button) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const key = form.dataset.key;
    if (!key) {
      status.textContent = status.dataset.notConfigured ?? '';
      status.dataset.state = 'error';
      return;
    }

    const data = new FormData(form);
    data.append('access_key', key);
    button.disabled = true;
    button.textContent = button.dataset.sending ?? '';
    status.textContent = '';

    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message);
      form.reset();
      status.textContent = status.dataset.success ?? '';
      status.dataset.state = 'success';
    } catch {
      status.textContent = status.dataset.error ?? '';
      status.dataset.state = 'error';
    } finally {
      button.disabled = false;
      button.textContent = button.dataset.label ?? '';
    }
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 72px;
    }
  }
  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .contact__lead {
    margin-top: 12px;
    color: var(--muted);
  }
  .contact__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact__list dt {
    font-size: 14px;
    color: var(--muted);
  }
  .contact__list dd {
    margin: 0;
  }
  .contact__big {
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }
  .contact__addr {
    font-weight: 700;
    font-size: 18px;
  }
  .contact__msg {
    display: flex;
    gap: 20px;
    font-weight: 700;
  }
  .contact__msg a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .form {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 36px;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 14px;
    font-weight: 600;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    border: 1px solid var(--input-border);
    background: var(--input);
    color: var(--text);
    border-radius: 3px;
    padding: 0 16px;
    font: inherit;
  }
  .field textarea {
    padding: 14px 16px;
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--orange);
    outline-offset: 0;
    border-color: transparent;
  }
  .form__submit {
    min-height: 56px;
    background: var(--orange);
    color: var(--on-orange);
    border: 0;
    border-radius: 3px;
    font: inherit;
    font-weight: 700;
    font-size: 17px;
    cursor: pointer;
  }
  .form__submit:hover {
    background: #ea8a36;
  }
  .form__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .form__status:empty {
    display: none;
  }
  .form__status[data-state='success'] {
    color: var(--text);
    font-weight: 600;
  }
  .form__status[data-state='error'] {
    color: var(--accent-text);
    font-weight: 600;
  }
</style>
