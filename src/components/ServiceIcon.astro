  )}
  {index === 4 && (
    <>
      <rect x="6" y="7" width="28" height="10" rx="2"></rect>
      <path d="M34 12h5v9H22v6"></path>
      <rect x="18" y="27" width="8" height="15" rx="2"></rect>
