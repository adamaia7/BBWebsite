---
import '../styles/global.css';
import { DEFAULT_THEME } from '../config';
import { dict, url, homeUrl, LANGS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** false = 404 და მსგავსი გვერდები, რომ საძიებოებმა არ დააინდექსონ */
  index?: boolean;
}

const { lang, index = true } = Astro.props;
const t = dict[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);
const ogLocale = lang === 'ka' ? 'ka_GE' : 'en_US';
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    {index && <link rel="canonical" href={abs(homeUrl(lang))} />}
    {index && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(homeUrl(l))} />)}
    {index && <link rel="alternate" hreflang="x-default" href={abs(homeUrl('ka'))} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BAU BILD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={abs(homeUrl(lang))} />
    <meta property="og:image" content={abs(url('og.jpg'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#16181b" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Montserrat:wght@400;700;800&family=Noto+Sans+Georgian:wght@400;500;600;700&display=swap"
    />

    <script is:inline define:vars={{ defaultTheme: DEFAULT_THEME }}>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : defaultTheme;
      } catch (e) {
        document.documentElement.dataset.theme = defaultTheme;
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
